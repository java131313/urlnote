# 前端镜像:Leptos WASM 静态包 + Vditor/mammoth/turndown/pdfjs 运行时资源
# + 词表与 IPADIC 词典(static/dict)。nginx 托管,默认 :80。
# 后端 API 地址由浏览器侧构建期注入(API_BASE build-arg → option_env!)。

FROM node:20-bookworm-slim AS fe-deps
WORKDIR /fe
COPY rust/frontend/package.json rust/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY rust/frontend/ ./
# 与 make rust-static/rust-frontend 相同的资源 staging
RUN mkdir -p static/vditor static/mammoth static/turndown static/pdfjs \
    && cp -R node_modules/vditor/dist static/vditor/dist \
    && cp node_modules/mammoth/mammoth.browser.min.js static/mammoth/ \
    && cp node_modules/turndown/dist/turndown.js static/turndown/ \
    && cp node_modules/pdfjs-dist/legacy/build/pdf.min.js \
          node_modules/pdfjs-dist/legacy/build/pdf.worker.min.js static/pdfjs/

FROM rust:1-bookworm AS fe-build
RUN rustup target add wasm32-unknown-unknown
RUN cargo install --locked trunk
WORKDIR /app/rust
COPY rust/Cargo.toml rust/Cargo.lock ./
# 精简 workspace:本阶段只需要 shared + frontend
RUN printf '[workspace]\nmembers = ["shared", "frontend"]\nresolver = "2"\n' > Cargo.toml
COPY rust/shared ./shared
COPY --from=fe-deps /fe ./frontend
WORKDIR /app/rust/frontend
# BASE_PATH/API_BASE 为编译期环境变量(main.rs option_env!)
ARG BASE_PATH=""
ARG API_BASE=""
ARG SUGGEST_LANG=""
ENV BASE_PATH=$BASE_PATH API_BASE=$API_BASE SUGGEST_LANG=$SUGGEST_LANG
RUN trunk build --release $(if [ -n "$BASE_PATH" ]; then echo "--public-url $BASE_PATH"; fi)

FROM nginx:1-alpine
COPY --from=fe-build /app/rust/frontend/dist /usr/share/nginx/html
# SPA 回退:便签路由(如 /u0yYk)无扩展名,交给 index.html
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
