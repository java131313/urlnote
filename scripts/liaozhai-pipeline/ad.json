{"195": {"title": "莲花公主", "notes": [["莲花公主", "本篇女主人公,公主。"], ["窦旭", "本篇男主人公。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "窦旭梦入莲花国,与莲花公主成婚。醒而异之,后梦复续之,但终不得久居。异史氏曰:梦国之婚,梦醒而绝;人间之婚,何异于此梦?", "gengai": ["起:梦入莲花国。", "承:与公主成婚。", "转:醒而异之。", "合:何异于人间。"], "people": [["窦旭", "主人", "梦而恋之"], ["莲花公主", "公主", "梦中之人"]], "pingxi": "「莲花公主」以梦写人间婚娶之幻,与「画壁」一脉而别是一境。", "mingju": "人间之婚,何异于此梦?", "motifs": {"main": "lotus", "accent": ""}}, "196": {"title": "绿衣女", "notes": [["绿衣女", "本篇女主人公。"], ["于景", "本篇男主人公。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "于景夜有绿衣女来,绿衣女善歌,歌声绕梁。后别去,于景思之。异史氏曰:绿衣之歌,绕梁而不绝。", "gengai": ["起:夜有绿衣女来。", "承:善歌。", "转:歌声绕梁。", "合:思之。"], "people": [["绿衣女", "歌者", "歌声绕梁"], ["于景", "主人", "思之"]], "pingxi": "「绿衣女」写歌,绕梁之音,鬼亦如仙。", "mingju": "歌声绕梁而不绝。", "motifs": {"main": "sound", "accent": ""}}, "197": {"title": "黎氏", "notes": [["黎氏", "本篇女主人公。"], ["谢中条", "本篇男主人公。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "谢中条纳黎氏为妾,黎氏实狐。后谢生事泄,黎氏乃去。异史氏曰:纳妾之纳,纳祸也。", "gengai": ["起:纳黎氏。", "承:实狐。", "转:事泄。", "合:乃去。"], "people": [["谢中条", "主人", "纳妾纳祸"], ["黎氏", "狐妾", "事泄而去"]], "pingxi": "「黎氏」写纳妾之祸,是《聊斋》的警世篇。", "mingju": "纳妾之纳,纳祸也。", "motifs": {"main": "fox", "accent": ""}}, "198": {"title": "荷花三娘子", "notes": [["荷花三娘子", "荷花所化之三娘子。"], ["宗湘若", "本篇主人。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "宗湘若遇荷花三娘子,三娘子荷之精灵,与之相恋。后三娘子别去,宗生思之。异史氏曰:荷之有情,人何以堪。", "gengai": ["起:遇荷花三娘子。", "承:相恋。", "转:别去。", "合:思之。"], "people": [["荷花三娘子", "荷精", "有情而去"], ["宗湘若", "主人", "思之"]], "pingxi": "「荷花三娘子」写荷之精灵,是《聊斋》物恋的清香一篇。", "mingju": "荷之有情,人何以堪。", "motifs": {"main": "lotus", "accent": "petals"}}, "199": {"title": "骂鸭", "notes": [["骂鸭", "骂鸭而鸭应,此写异事。"], ["白庄", "本篇主人。"], ["鸭", "此指其鸭。"], ["异史氏曰", "论赞。"]], "yiyi": "白庄失鸭,骂之,鸭自归。异史氏曰:骂而鸭归,鸭之通灵,亦人之通鸭也。", "gengai": ["起:失鸭。", "承:骂之。", "转:鸭自归。", "合:通灵。"], "people": [["白庄", "主人", "骂而鸭归"], ["鸭", "灵禽", "自归"]], "pingxi": "「骂鸭」写鸭之通灵,是《聊斋》的诙谐小品。", "mingju": "骂而鸭归。", "motifs": {"main": "bird", "accent": ""}}, "200": {"title": "柳氏子", "notes": [["柳氏子", "本篇主人。"], ["冥府", "地府。"], ["托梦", "此指亡父托梦。"], ["异史氏曰", "论赞。"]], "yiyi": "柳氏子之父死,托梦于子,言冥府事,劝子行善。子从之。异史氏曰:父之托梦,爱之至也。", "gengai": ["起:父死托梦。", "承:言冥府事。", "转:劝行善。", "合:子从之。"], "people": [["柳氏子", "主人", "从父梦之劝"], ["父", "托梦者", "爱之至"]], "pingxi": "「柳氏子」写父之托梦,亲情生死不隔,是《聊斋》的温情小记。", "mingju": "父之托梦,爱之至也。", "motifs": {"main": "ghost", "accent": ""}}}