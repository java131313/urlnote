{"108": {"title": "于江", "notes": [["于江", "本篇主人。"], ["于七", "清初山东起义领袖,此借其乱写兵燹。"], ["掖县", "山东旧县名。"], ["猾", "狡猾。"], ["异史氏曰", "论赞。"]], "yiyi": "于江之父死于于七之乱,江年幼,志报父仇。长大后侦得杀父者,手刃之。异史氏曰:父仇不共戴天,于江之志,可悯可钦。", "gengai": ["起:父死乱中。", "承:江立志复仇。", "转:侦得杀父者。", "合:手刃之。"], "people": [["于江", "复仇者", "父仇得报"]], "pingxi": "「于江」写复仇,与商三官同类,而多了孤儿之苦。", "mingju": "父仇不共戴天。", "motifs": {"main": "sword", "accent": ""}}, "109": {"title": "小二", "notes": [["小二", "本篇女主人公。"], ["赵旺", "本篇男主人公。"], ["织", "纺织。"], ["异史氏曰", "论赞。"]], "yiyi": "赵旺娶小二,小二善织,家以小康。后小二死,赵生益贫。异史氏曰:妻之贤,不可复得。", "gengai": ["起:娶小二。", "承:善织而富。", "转:小二死。", "合:赵生益贫。"], "people": [["小二", "贤妻", "善织"], ["赵旺", "主人", "失妻而贫"]], "pingxi": "「小二」写市井夫妻,小民之悲欢。", "mingju": "妻之贤,不可复得。", "motifs": {"main": "weave", "accent": ""}}, "110": {"title": "庚娘", "notes": [["庚娘", "本篇女主人公。"], ["金大用", "其夫。"], ["水贼", "此指劫船之盗。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "金大用夫妇乘船,遇水贼劫船,大用被杀。庚娘佯从贼,伺机刺杀贼首,自投于水。异史氏曰:庚娘之烈,鬼神可泣。", "gengai": ["起:遇贼劫船。", "承:夫被杀,庚娘佯从。", "转:刺杀贼首。", "合:自投于水。"], "people": [["庚娘", "烈女", "忍辱而报夫仇"], ["金大用", "其夫", "死难于贼"]], "pingxi": "「庚娘」写烈女之忍,忍之至而后报之至。", "mingju": "庚娘之烈,鬼神可泣。", "motifs": {"main": "sword", "accent": "wave"}}, "111": {"title": "宫梦弼", "notes": [["宫梦弼", "本篇主人。"], ["刘芳辉", "本篇另一人。"], ["燕", "燕山,今河北一带。"], ["觊", "jì,觊觎。"], ["异史氏曰", "论赞。"]], "yiyi": "宫梦弼与刘芳辉友善,刘死,宫抚其子。后刘之子中举,宫乃别去。异史氏曰:友之德,死而不已。", "gengai": ["起:宫与刘善。", "承:刘死抚孤。", "转:孤中举。", "合:宫别去。"], "people": [["宫梦弼", "义友", "抚孤成名"], ["刘芳辉", "其友", "死而托孤"]], "pingxi": "「宫梦弼」写朋友之义,死而不已。", "mingju": "友之德,死而不已。", "motifs": {"main": "child", "accent": ""}}, "112": {"title": "雊鹆", "notes": [["雊鹆", "gòu yù,八哥。"], ["王子", "此指养八哥者。"], ["绦", "tāo,丝带。"], ["异史氏曰", "论赞。"]], "yiyi": "一王子养八哥,八哥善言。后八哥飞去,王子思念成疾。异史氏曰:物之有情,亦足以感人。", "gengai": ["起:养八哥。", "承:八哥善言。", "转:飞去。", "合:思念成疾。"], "people": [["王子", "养鸟者", "情系八哥"], ["八哥", "灵鸟", "飞去而留情"]], "pingxi": "「雊鹆」写物情,是《聊斋》人情观的延伸。", "mingju": "物之有情,亦足以感人。", "motifs": {"main": "bird", "accent": ""}}, "113": {"title": "刘海石", "notes": [["刘海石", "本篇主人,未名。"], ["山左", "山东。"], ["侔", "móu,相等。"], ["异史氏曰", "论赞。"]], "yiyi": "刘海石善技击,与一僧较,胜之。异史氏曰:技之高,不以僧俗。", "gengai": ["起:善技击。", "承:与僧较。", "转:胜之。", "合:技之高不以僧俗。"], "people": [["刘海石", "技击者", "胜僧"], ["僧", "对手", "技侔而负"]], "pingxi": "「刘海石」写技,与前篇一脉。", "mingju": "技之高,不以僧俗。", "motifs": {"main": "sword", "accent": ""}}, "114": {"title": "谕鬼", "notes": [["谕鬼", "告谕之鬼。"], ["陈公", "本篇主人。"], ["恳", "诚恳。"], ["异史氏曰", "论赞。"]], "yiyi": "陈公夜有鬼来,恳求一饭。陈公食之,鬼乃去。异史氏曰:鬼之恳,人之仁。", "gengai": ["起:鬼来恳求。", "承:陈公食之。", "转:鬼去。", "合:鬼之恳,人之仁。"], "people": [["陈公", "主人", "仁而食鬼"], ["鬼", "恳求者", "得食而去"]], "pingxi": "「谕鬼」写仁,小而可亲。", "mingju": "鬼之恳,人之仁。", "motifs": {"main": "ghost", "accent": ""}}}