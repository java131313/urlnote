{"155": {"title": "双灯", "notes": [["双灯", "二灯,此写异兆。"], ["魏运旺", "本篇主人。"], ["异史氏曰", "论赞。"]], "yiyi": "魏运旺夜行,见双灯引路,随之至一宅,遇美人。后美人别去,双灯亦灭。异史氏曰:灯之引,缘之牵也。", "gengai": ["起:夜见双灯。", "承:随之至宅。", "转:遇美人。", "合:灯灭人别。"], "people": [["魏运旺", "主人", "随灯而遇"], ["美人", "灯下人", "缘尽而别"]], "pingxi": "「双灯」以灯写缘,来得明,去得净。", "mingju": "灯之引,缘之牵也。", "motifs": {"main": "lantern", "accent": ""}}, "156": {"title": "捉鬼射狐", "notes": [["捉鬼射狐", "捉鬼而射狐,总写驱邪之事。"], ["李著明", "本篇主人。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "李著明家,有鬼有狐,李以勇力和之,射狐中箭,狐死而祟绝。异史氏曰:勇可伏狐,正可辟邪。", "gengai": ["起:家有鬼狐。", "承:李以勇力。", "转:射狐中箭。", "合:祟绝。"], "people": [["李著明", "主人", "勇而正"], ["狐", "被射者", "死而祟绝"]], "pingxi": "「捉鬼射狐」写人之勇正,是《聊斋》驱邪系列的合奏。", "mingju": "勇可伏狐,正可辟邪。", "motifs": {"main": "fox", "accent": "sword"}}, "157": {"title": "蹇偿债", "notes": [["蹇偿债", "以跛足偿其债。"], ["李公", "本篇主人。"], ["蹇", "jiǎn,跛足。"], ["异史氏曰", "论赞。"]], "yiyi": "李公曾负人债,后遇一跛足人,知是其债之报。偿之,跛愈。异史氏曰:债之偿也,或钱或命,或足。", "gengai": ["起:曾负人债。", "承:遇跛足人。", "转:知是债报。", "合:偿之跛愈。"], "people": [["李公", "主人", "偿债而愈人"], ["跛足人", "债报", "得偿而愈"]], "pingxi": "「蹇偿债」写因果之偿,形式不拘,或钱或足。", "mingju": "债之偿也,或钱或命,或足。", "motifs": {"main": "coins", "accent": ""}}, "158": {"title": "头滚", "notes": [["头滚", "头自动滚动,此写异兆。"], ["苏孝廉", "本篇主人。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "苏孝廉家,一头自户中滚出,滚至庭中而止。异史氏曰:头之滚,兆之动也;兆之动,心之疑也。", "gengai": ["起:头自户出。", "承:滚至庭中。", "转:而止。", "合:心之疑也。"], "people": [["苏孝廉", "主人", "见而异之"], ["头", "异兆", "滚而即止"]], "pingxi": "「头滚」写异兆,以「疑」字收束。", "mingju": "兆之动,心之疑也。", "motifs": {"main": "ghost", "accent": ""}}, "159": {"title": "鬼作筵", "notes": [["鬼作筵", "鬼设筵席。"], ["田公", "本篇主人。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "田公家,夜闻作筵之声,鬼影幢幢。田公不惧,鬼乃设筵谢之。异史氏曰:鬼之谢,甚于人之谢。", "gengai": ["起:夜闻筵声。", "承:鬼影幢幢。", "转:田公不惧。", "合:鬼设筵谢。"], "people": [["田公", "主人", "不惧而受谢"], ["鬼", "设筵者", "谢甚于人"]], "pingxi": "「鬼作筵」写人鬼之礼,鬼之谢甚于人之谢,是讽刺,也是温柔。", "mingju": "鬼之谢,甚于人之谢。", "motifs": {"main": "wine", "accent": "ghost2"}}, "160": {"title": "胡四相公", "notes": [["胡四相公", "狐之长者,排行第四。"], ["张虚一", "本篇主人。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "张虚一与胡四相公交,四相公知张将有难,预警之。张得免,甚德之。异史氏曰:狐之交,以信以义。", "gengai": ["起:与四相公交。", "承:四相公预警。", "转:张得免。", "合:以信以义。"], "people": [["张虚一", "主人", "得狐之助"], ["胡四相公", "狐长者", "预警而义"]], "pingxi": "「胡四相公」写狐之信义,与「酒友」一脉。", "mingju": "狐之交,以信以义。", "motifs": {"main": "fox", "accent": "wine2"}}}