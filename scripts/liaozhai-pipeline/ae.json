{"201": {"title": "上仙", "notes": [["上仙", "上界之仙。"], ["胶州", "山东旧县名。"], ["药", "仙药。"], ["异史氏曰", "论赞。"]], "yiyi": "一上仙下降,授人以药,服之延年。异史氏曰:上仙之药,亦待有缘。", "gengai": ["起:上仙下降。", "承:授药。", "转:服之。", "合:延年。"], "people": [["上仙", "仙人", "授药"], ["受者", "有缘人", "延年"]], "pingxi": "「上仙」写仙药待缘,是《聊斋》中的遇仙小记。", "mingju": "上仙之药,亦待有缘。", "motifs": {"main": "priest", "accent": ""}}, "202": {"title": "侯静山", "notes": [["侯静山", "本篇主人,未名。"], ["山", "此写山行之异。"], ["异史氏曰", "论赞。"]], "yiyi": "侯静山入山,遇异人,得导引之术。异史氏曰:山中之遇,静者得之。", "gengai": ["起:入山。", "承:遇异人。", "转:得导引术。", "合:静者得之。"], "people": [["侯静山", "主人", "静而得遇"], ["异人", "授术者", "山中"]], "pingxi": "「侯静山」以人名山,以山写静,命名即寓意。", "mingju": "山中之遇,静者得之。", "motifs": {"main": "mountain", "accent": ""}}, "203": {"title": "钱流", "notes": [["钱流", "钱如流水,此指挥霍。"], ["诸城", "山东旧县名。"], ["异史氏曰", "论赞。"]], "yiyi": "一人暴富,钱如流水而尽。异史氏曰:钱之流也,不择其流;人之守也,在其人。", "gengai": ["起:暴富。", "承:钱如流水。", "转:而尽。", "合:在其人。"], "people": [["其人", "暴富者", "钱流而尽"]], "pingxi": "「钱流」写挥霍,与前「雨钱」互映。", "mingju": "钱之流也,不择其流。", "motifs": {"main": "coins", "accent": ""}}, "204": {"title": "郭生", "notes": [["郭生", "本篇主人。"], ["遇", "此写其遇狐。"], ["媪", "老妇。"], ["异史氏曰", "论赞。"]], "yiyi": "郭生遇狐,狐助其文思,遂入泮。异史氏曰:狐之助文,亦助其人也。", "gengai": ["起:遇狐。", "承:助文思。", "转:入泮。", "合:助其人。"], "people": [["郭生", "主人", "遇狐而进"], ["狐", "助者", "助文"]], "pingxi": "「郭生」写狐助文,与「叶生」之写才同调。", "mingju": "狐之助文,亦助其人。", "motifs": {"main": "fox", "accent": "scroll"}}, "205": {"title": "金生色", "notes": [["金生色", "本篇主人,未名,金姓。"], ["色", "此写其惑于色。"], ["异史氏曰", "论赞。"]], "yiyi": "金生色惑于一女子,女子实鬼,几死。异史氏曰:色之惑人,其鬼如此。", "gengai": ["起:惑于色。", "承:女子实鬼。", "转:几死。", "合:色之惑人。"], "people": [["金生色", "主人", "惑而几死"], ["女", "鬼", "惑人"]], "pingxi": "「金生色」以名寓意,写色之惑,与「画皮」一脉。", "mingju": "色之惑人,其鬼如此。", "motifs": {"main": "ghost", "accent": ""}}, "206": {"title": "彭海秋", "notes": [["彭海秋", "本篇主人,渔于海上。"], ["海", "此写其海上之遇。"], ["异史氏曰", "论赞。"]], "yiyi": "彭海秋渔于海,遇仙舟,邀之游,历海外诸国。归而异之。异史氏曰:海之遇,渔人之仙缘也。", "gengai": ["起:渔于海。", "承:遇仙舟。", "转:历海外。", "合:渔人仙缘。"], "people": [["彭海秋", "渔人", "海上仙缘"]], "pingxi": "「彭海秋」写海上仙缘,与「海公子」同调。", "mingju": "海之遇,渔人之仙缘也。", "motifs": {"main": "sea", "accent": ""}}, "207": {"title": "堪舆", "notes": [["堪舆", "kān yú,风水之术。"], ["术", "此指其术之妄。"], ["异史氏曰", "论赞。"]], "yiyi": "一术人精堪舆,言人祸福皆验。异史氏曰:堪舆之术,验于妄,不验于诚。", "gengai": ["起:精堪舆。", "承:言祸福验。", "转:术之妄。", "合:验于妄。"], "people": [["术人", "风水者", "术验于妄"]], "pingxi": "「堪舆」写风水之妄,是《聊斋》的破除迷信篇。", "mingju": "堪舆之术,验于妄。", "motifs": {"main": "mountain", "accent": ""}}}