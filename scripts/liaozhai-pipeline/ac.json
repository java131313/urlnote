{"188": {"title": "狮子", "notes": [["狮子", "此指西域所贡之狮。"], ["西商", "西域商人。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "西域商人贡狮,狮大如驴,吼声如雷。国人聚观。异史氏曰:异物之来,见者足戒。", "gengai": ["起:贡狮。", "承:大如驴。", "转:吼如雷。", "合:见者足戒。"], "people": [["狮子", "异物", "大而猛"], ["国人", "观者", "聚观"]], "pingxi": "「狮子」写异物,是《聊斋》的博物小记。", "mingju": "异物之来,见者足戒。", "motifs": {"main": "python", "accent": ""}}, "189": {"title": "阎王", "notes": [["阎王", "阎罗王,此写其暂摄于人。"], ["李季霖", "本篇主人。"], ["异史氏曰", "论赞。"]], "yiyi": "李季霖死摄阎王事,理案数日,放还。异史氏曰:阎王之摄,以试人也。", "gengai": ["起:死摄阎王。", "承:理案数日。", "转:放还。", "合:以试人。"], "people": [["李季霖", "主人", "摄而放还"]], "pingxi": "「阎王」与「李伯言」同调,写冥职之暂摄。", "mingju": "阎王之摄,以试人也。", "motifs": {"main": "judge", "accent": ""}}, "190": {"title": "土偶", "notes": [["土偶", "泥土偶人。"], ["于家", "本篇主人。"], ["观", "庙观之像。"], ["异史氏曰", "论赞。"]], "yiyi": "于家儿见庙中土偶夜动,惧而告父。异史氏曰:土偶之动,人心之动也。", "gengai": ["起:见土偶夜动。", "承:惧告父。", "转:人心之动。", "合:如此。"], "people": [["于家儿", "见者", "惧而告"], ["土偶", "像", "夜动"]], "pingxi": "「土偶」以像写心,与前「泥书生」互映。", "mingju": "土偶之动,人心之动也。", "motifs": {"main": "scholar", "accent": ""}}, "191": {"title": "长治女子", "notes": [["长治", "山西旧县名。"], ["女子", "此写其异。"], ["观", "此指道观。"], ["异史氏曰", "论赞。"]], "yiyi": "一女子入道观学道,后有异术,能知人之祸福。异史氏曰:女子之道,亦成于笃。", "gengai": ["起:入观学道。", "承:有异术。", "转:知人祸福。", "合:成于笃。"], "people": [["女子", "道姑", "学道成术"]], "pingxi": "「长治女子」写女冠之学道,是《聊斋》中的女仙小记。", "mingju": "女子之道,亦成于笃。", "motifs": {"main": "priest", "accent": ""}}, "192": {"title": "义犬", "notes": [["义犬", "讲义气之犬。"], ["潞安", "山西旧府名。"], ["救", "此写犬救主。"], ["异史氏曰", "论赞。"]], "yiyi": "一犬救主于难,主得脱,犬死。异史氏曰:犬之义,人之师也。", "gengai": ["起:主有难。", "承:犬救之。", "转:主得脱。", "合:犬死。"], "people": [["犬", "义犬", "救主而死"], ["主人", "被救者", "得脱"]], "pingxi": "「义犬」写犬义,与「义鼠」「蛇人」同为物之师。", "mingju": "犬之义,人之师也。", "motifs": {"main": "dog", "accent": ""}}, "193": {"title": "鄱阳神", "notes": [["鄱阳", "鄱阳湖。"], ["神", "此写湖神之异。"], ["异史氏曰", "论赞。"]], "yiyi": "舟过鄱阳,遇神风,舟几覆。祷之,乃安。异史氏曰:神风之怒,祷之而安。", "gengai": ["起:过鄱阳。", "承:遇神风。", "转:祷之。", "合:乃安。"], "people": [["舟人", "过湖者", "祷而得安"]], "pingxi": "「鄱阳神」写江湖之险与祷安之俗。", "mingju": "神风之怒,祷之而安。", "motifs": {"main": "sea", "accent": ""}}, "194": {"title": "伍秋月", "notes": [["伍秋月", "本篇女主人公。"], ["王鼎", "本篇男主人公。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "王鼎遇女伍秋月,两情相悦。后王生有难,秋月以术救之。异史氏曰:秋月之救,情之深也。", "gengai": ["起:遇伍秋月。", "承:两情相悦。", "转:王有难。", "合:秋月救之。"], "people": [["伍秋月", "女", "情深而救"], ["王鼎", "主人", "得救"]], "pingxi": "「伍秋月」写情之深可以救难,是《聊斋》情本位的一贯。", "mingju": "情之深也。", "motifs": {"main": "maiden", "accent": ""}}}