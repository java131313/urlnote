{"255": {"title": "戏缢", "notes": [["戏缢", "以缢为戏,此写其险。"], ["淄川", "山东旧县名。"], ["异史氏曰", "论赞。"]], "yiyi": "一人以缢为戏,几死。异史氏曰:戏之险,险于真;真之死,死于戏。", "gengai": ["起:以缢为戏。", "承:几死。", "转:如此。", "合:死于戏。"], "people": [["其人", "戏者", "几死"]], "pingxi": "「戏缢」写戏之险,是《聊斋》的劝慎篇。", "mingju": "真之死,死于戏。", "motifs": {"main": "ghost", "accent": ""}}, "256": {"title": "罗祖", "notes": [["罗祖", "本篇主人,胶州人。"], ["大珠", "此指佛之大珠。"], ["髡", "kūn,剃发。"], ["异史氏曰", "论赞。"]], "yiyi": "罗祖从军,有异遇,得佛法,乃髡而为僧。异史氏曰:罗祖之祖,祖于佛;佛之祖,祖于心。", "gengai": ["起:从军。", "承:有异遇。", "转:得佛法而髡。", "合:祖于心。"], "people": [["罗祖", "主人", "弃武从佛"]], "pingxi": "「罗祖」写弃武从佛,是《聊斋》的方外篇。", "mingju": "佛之祖,祖于心。", "motifs": {"main": "monk", "accent": ""}}, "257": {"title": "刘姓", "notes": [["刘姓", "本篇主人,未名。"], ["青州", "山东旧府名。"], ["黠", "xiá,狡猾。"], ["异史氏曰", "论赞。"]], "yiyi": "一刘姓者,狡而贪,为狐所戏,财尽乃已。异史氏曰:贪之戏,戏于狐,亦戏于心。", "gengai": ["起:狡而贪。", "承:为狐所戏。", "转:财尽。", "合:戏于心。"], "people": [["刘姓", "贪者", "为狐所戏"], ["狐", "戏者", "戏贪"]], "pingxi": "「刘姓」写贪之被戏,与「种梨」一脉。", "mingju": "戏于狐,亦戏于心。", "motifs": {"main": "fox", "accent": "coins"}}, "258": {"title": "邵女", "notes": [["邵女", "本篇女主人公。"], ["柴廷宾", "本篇男主人公。"], ["觇", "chān,窥视。"], ["媪", "老妇。"], ["异史氏曰", "论赞。"]], "yiyi": "柴廷宾纳邵女,邵女贤,佐理家事,家以日兴。异史氏曰:邵女之贤,贤而不妒,妾道之难也。", "gengai": ["起:纳邵女。", "承:贤而佐家。", "转:家以日兴。", "合:贤而不妒。"], "people": [["邵女", "妾", "贤而不妒"], ["柴廷宾", "主人", "得贤妾"]], "pingxi": "「邵女」写妾之贤,「贤而不妒」四字,是《聊斋》对妾道的最高评价——可见其时代局限,亦可见其人物之真。", "mingju": "贤而不妒。", "motifs": {"main": "maiden", "accent": ""}}, "259": {"title": "巩仙", "notes": [["巩仙", "本篇主人,巩道士。"], ["尚秀才", "本篇另一人。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "巩道士有异术,以术济人。尚秀才慕之,从之学。异史氏曰:仙之术,术于济人;人之慕,慕于术。", "gengai": ["起:巩道士有异术。", "承:以术济人。", "转:尚秀才从学。", "合:术于济人。"], "people": [["巩仙", "道士", "以术济人"], ["尚秀才", "从学者", "慕术"]], "pingxi": "「巩仙」写术之济人,是《聊斋》的方术正篇。", "mingju": "术于济人。", "motifs": {"main": "priest", "accent": ""}}, "260": {"title": "二商", "notes": [["二商", "本篇主人,行二。"], ["商", "此指其业。"], ["异史氏曰", "论赞。"]], "yiyi": "二商为商,有异遇,得金致富。异史氏曰:商之二,二于其遇;遇之金,金于其诚。", "gengai": ["起:二商为商。", "承:有异遇。", "转:得金致富。", "合:金于其诚。"], "people": [["二商", "商人", "遇金而富"]], "pingxi": "「二商」写商人之遇,命名即寓其偶。", "mingju": "遇之金,金于其诚。", "motifs": {"main": "coins", "accent": ""}}}