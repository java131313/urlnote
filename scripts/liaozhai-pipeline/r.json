{"115": {"title": "泥鬼", "notes": [["泥鬼", "泥塑之鬼。"], ["唐梦赉", "字济武,号岚亭,淄川人,官至翰林院检讨。"], ["博", "此指博戏。"], ["异史氏曰", "论赞。"]], "yiyi": "唐梦赉于庙中见泥鬼,夜梦泥鬼来博,输而怒。唐醒而悟,戒博。异史氏曰:泥鬼之博,赌戒也。", "gengai": ["起:见泥鬼。", "承:梦与博。", "转:输而怒。", "合:戒博。"], "people": [["唐梦赉", "主人", "因梦戒博"], ["泥鬼", "梦中对手", "输而怒"]], "pingxi": "「泥鬼」以梦戒赌,是《聊斋》的劝世小品。", "mingju": "泥鬼之博,赌戒也。", "motifs": {"main": "ghost", "accent": "coins"}}, "116": {"title": "梦别", "notes": [["梦别", "梦中相别。"], ["毕怡庵", "本篇主人。"], ["荆", "此指旧友。"], ["异史氏曰", "论赞。"]], "yiyi": "毕怡庵梦与亡友别,友言冥府事。醒而数日,友讣至——死期即梦别之日。异史氏曰:梦之先,情之深也。", "gengai": ["起:梦与友别。", "承:友言冥事。", "转:醒而讣至。", "合:梦之先,情之深。"], "people": [["毕怡庵", "主人", "梦先而信后"], ["亡友", "死者", "梦别而逝"]], "pingxi": "「梦别」写朋友之情,先梦而后死,情之深也。", "mingju": "梦之先,情之深也。", "motifs": {"main": "ghost", "accent": ""}}, "117": {"title": "犬灯", "notes": [["犬灯", "犬形之灯,此指异兆。"], ["韩生", "本篇主人。"], ["祝", "祝祷。"], ["异史氏曰", "论赞。"]], "yiyi": "韩生夜见犬灯之异,祝之,灯化为犬而去。异史氏曰:异之来,祝之去,信之则灵。", "gengai": ["起:夜见犬灯。", "承:祝之。", "转:化为犬。", "合:信之则灵。"], "people": [["韩生", "主人", "见而异,祝而平"], ["犬灯", "异兆", "化犬而去"]], "pingxi": "「犬灯」写异兆之来与祝祷之去。", "mingju": "信之则灵。", "motifs": {"main": "dog", "accent": "flame"}}, "118": {"title": "番僧", "notes": [["番僧", "西域之僧。"], ["身毒", "古印度。"], ["咒", "咒语。"], ["异史氏曰", "论赞。"]], "yiyi": "一番僧自西域来,有异咒,能驱鬼。人试之,鬼现形。异史氏曰:咒之灵,系于持者。", "gengai": ["起:番僧至。", "承:有异咒。", "转:驱鬼现形。", "合:系于持者。"], "people": [["番僧", "异僧", "咒驱鬼"]], "pingxi": "「番僧」与「西僧」同调,写外来之术。", "mingju": "咒之灵,系于持者。", "motifs": {"main": "priest", "accent": ""}}, "119": {"title": "狐妾", "notes": [["狐妾", "狐为妾。"], ["刘洞九", "本篇主人。"], ["罍", "léi,酒器。"], ["异史氏曰", "论赞。"]], "yiyi": "刘洞九纳狐妾,狐妾贤而慧,佐理家事。后别去。异史氏曰:狐之佐人,人不及也。", "gengai": ["起:纳狐妾。", "承:贤慧佐家。", "转:别去。", "合:狐之佐人。"], "people": [["刘洞九", "主人", "得狐之助"], ["狐妾", "贤妾", "佐家而去"]], "pingxi": "「狐妾」写狐之贤,与胡氏一脉。", "mingju": "狐之佐人,人不及也。", "motifs": {"main": "fox", "accent": ""}}, "120": {"title": "雷曹", "notes": [["雷曹", "雷部之曹官,掌雷电。"], ["孙生", "本篇主人。"], ["霹雳", "疾雷。"], ["异史氏曰", "论赞。"]], "yiyi": "孙生夜见雷曹,雷曹言其前世为雷吏,谪降人间。今生满,当复归。孙生乃悟,后卒。异史氏曰:谪仙之谪,满而复归。", "gengai": ["起:夜见雷曹。", "承:言前世雷吏。", "转:今生满当归。", "合:卒。"], "people": [["孙生", "谪吏", "满而复归"], ["雷曹", "来迎者", "执前职"]], "pingxi": "「雷曹」写谪仙之归,是《聊斋》仙谪系列的一则。", "mingju": "谪降人间,满而复归。", "motifs": {"main": "storm", "accent": ""}}}