{"221": {"title": "白莲教", "notes": [["白莲教", "此篇与卷三「白莲教」同题,记教门之异。"], ["此", "此指其事之异。"], ["异史氏曰", "论赞。"]], "yiyi": "白莲教徒有异术,以术聚众,后为官兵所破。异史氏曰:术之聚众,众之愚也;愚之破,术之破也。", "gengai": ["起:教有异术。", "承:聚众。", "转:官兵破之。", "合:术破而愚醒。"], "people": [["教徒", "术者", "聚众"], ["官兵", "破者", "破术"]], "pingxi": "卷六「白莲教」与卷三同题,而写教门之终局。", "mingju": "术破而愚醒。", "motifs": {"main": "sorcerer", "accent": "crowd"}}, "222": {"title": "颜氏", "notes": [["颜氏", "本篇女主人公。"], ["顺天", "北京一带。"], ["须眉", "男子。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "颜氏女而有须眉之志,女扮男装应考,中进士,官至刺史。异史氏曰:颜氏之须眉,掩其巾帼;今之巾帼,掩其须眉。", "gengai": ["起:颜氏有志。", "承:女扮男装。", "转:中进士。", "合:官至刺史。"], "people": [["颜氏", "才女", "须眉之志"], ["其夫", "对比者", "不如妻"]], "pingxi": "「颜氏」写女子之才,压倒须眉。蒲松龄于女性之才,一往情深。", "mingju": "今之巾帼,掩其须眉。", "motifs": {"main": "scholar", "accent": ""}}, "223": {"title": "杜翁", "notes": [["杜翁", "本篇主人。"], ["赀", "zī,资财。"], ["异史氏曰", "论赞。"]], "yiyi": "杜翁有赀而吝,后为狐所祟,散尽家财乃安。异史氏曰:吝之散财,散于狐而散其吝。", "gengai": ["起:有赀而吝。", "承:狐祟。", "转:散尽乃安。", "合:散其吝。"], "people": [["杜翁", "吝者", "散财而安"]], "pingxi": "「杜翁」写吝之散,与「种梨」一脉。", "mingju": "散于狐而散其吝。", "motifs": {"main": "coins", "accent": "fox2"}}, "224": {"title": "小谢", "notes": [["小谢", "本篇女主人公之一,鬼女。"], ["陶生", "本篇男主人公。"], ["秋容", "另一鬼女。"], ["媪", "老妇。"], ["异史氏曰", "论赞。"]], "yiyi": "陶生夜有鬼女小谢、秋容来,二女事生甚谨。后陶生有难,二女救之,得脱。异史氏曰:鬼之报德,如此其挚。", "gengai": ["起:二女夜来。", "承:事生甚谨。", "转:陶有难。", "合:二女救之。"], "people": [["小谢", "鬼女", "报德而挚"], ["秋容", "鬼女", "同事"], ["陶生", "主人", "得救"]], "pingxi": "「小谢」写鬼女之报,与「聂小倩」一脉,而二女共事,别是一番境界。", "mingju": "鬼之报德,如此其挚。", "motifs": {"main": "ghosts", "accent": ""}}, "225": {"title": "缢鬼", "notes": [["缢鬼", "自缢而死之鬼。"], ["泰安", "山东泰安。"], ["异史氏曰", "论赞。"]], "yiyi": "一缢鬼求代,见其人贫而勤,不忍,乃去。异史氏曰:鬼之不忍,人之师也。", "gengai": ["起:缢鬼求代。", "承:见人贫勤。", "转:不忍。", "合:乃去。"], "people": [["缢鬼", "求代者", "不忍而去"], ["其人", "贫勤者", "得免"]], "pingxi": "「缢鬼」写鬼之不忍,与「祝翁」同是心软之鬼。", "mingju": "鬼之不忍,人之师也。", "motifs": {"main": "ghost", "accent": ""}}, "226": {"title": "吴门画工", "notes": [["吴门", "苏州。"], ["画工", "画家。"], ["吴甲", "本篇主人,未名。"], ["异史氏曰", "论赞。"]], "yiyi": "一吴门画工,技进乎道,所画人物皆活。异史氏曰:技之进道,画工之画,画其魂也。", "gengai": ["起:善画。", "承:技进乎道。", "转:人物皆活。", "合:画其魂也。"], "people": [["画工", "画家", "画魂"], ["其画", "活画", "若真"]], "pingxi": "「吴门画工」写技进乎道,是《聊斋》的艺术论。", "mingju": "画工之画,画其魂也。", "motifs": {"main": "mural", "accent": ""}}, "227": {"title": "林氏", "notes": [["林氏", "本篇女主人公。"], ["戚生", "本篇男主人公。"], ["觇", "chān,窥视。"], ["异史氏曰", "论赞。"]], "yiyi": "戚生娶林氏,林氏有异味,戚渐觉其异,林氏实狐。异史氏曰:狐之异味,人之异心也。", "gengai": ["起:娶林氏。", "承:有异味。", "转:实狐。", "合:异心之喻。"], "people": [["林氏", "狐", "异味而去"], ["戚生", "主人", "觉而异之"]], "pingxi": "「林氏」以异味写异心,是《聊斋》的含蓄篇。", "mingju": "狐之异味,人之异心也。", "motifs": {"main": "fox", "accent": ""}}}