{"208": {"title": "窦氏", "notes": [["窦氏", "本篇女主人公。"], ["南三复", "本篇男主人公。"], ["觇", "chān,窥视。"], ["媪", "老妇。"], ["异史氏曰", "论赞。"]], "yiyi": "南三复诱窦氏,后又弃之,窦氏死而为厉,报之。异史氏曰:窦氏之厉,报其负心;世之负心者,当知警。", "gengai": ["起:南诱窦氏。", "承:弃之。", "转:窦死为厉。", "合:报之。"], "people": [["窦氏", "被弃女", "死而为厉"], ["南三复", "负心人", "受报"]], "pingxi": "「窦氏」写负心之报,与前「阿霞」一脉,而报得更厉。", "mingju": "窦氏之厉,报其负心。", "motifs": {"main": "ghost", "accent": "flame"}}, "209": {"title": "梁彦", "notes": [["梁彦", "本篇主人。"], ["粱", "梁上之鼠。"], ["异史氏曰", "论赞。"]], "yiyi": "梁彦家梁上有鼠,昼伏夜动,盗其粮。异史氏曰:梁上之鼠,盗人之粮;梁上之人,盗国之粮。", "gengai": ["起:梁上有鼠。", "承:夜动盗粮。", "转:如此。", "合:梁上之人。"], "people": [["梁彦", "主人", "患梁上鼠"], ["鼠", "盗者", "盗粮"]], "pingxi": "「梁彦」以鼠喻盗,讽刺之笔藏于幽默。", "mingju": "梁上之人,盗国之粮。", "motifs": {"main": "mice", "accent": ""}}, "210": {"title": "龙肉", "notes": [["龙肉", "龙之肉,此写其味。"], ["献", "此指进献。"], ["异史氏曰", "论赞。"]], "yiyi": "一龙坠地死,乡人分食之,味极美。异史氏曰:龙肉之美,美在其死;人心之贪,贪在其美。", "gengai": ["起:龙坠死。", "承:分食之。", "转:味极美。", "合:贪在其美。"], "people": [["乡人", "分食者", "食其肉"], ["龙", "死者", "肉美"]], "pingxi": "「龙肉」以食写贪,冷峭如刀。", "mingju": "人心之贪,贪在其美。", "motifs": {"main": "dragon", "accent": ""}}, "211": {"title": "潞令", "notes": [["潞令", "潞安府令,未名。"], ["贪", "此写其贪暴。"], ["异史氏曰", "论赞。"]], "yiyi": "潞令贪暴,民不堪命。一士人上疏劾之,得罢免。异史氏曰:贪令之去,民之幸也。", "gengai": ["起:令贪暴。", "承:民不堪。", "转:士人劾之。", "合:罢免。"], "people": [["潞令", "贪官", "被劾去"], ["士人", "上疏者", "为民除害"]], "pingxi": "「潞令」写贪令之劾,是《聊斋》的吏治篇。", "mingju": "贪令之去,民之幸也。", "motifs": {"main": "judge", "accent": ""}}, "212": {"title": "马介甫", "notes": [["马介甫", "本篇主人,术士。"], ["杨万石", "本篇另一人。"], ["觇", "chān,窥视。"], ["媪", "老妇。"], ["异史氏曰", "论赞。"]], "yiyi": "马介甫有异术,与杨万石交。杨妻悍,马介甫以术摄之,妻乃柔。异史氏曰:术之摄悍,摄其悍也;心之去悍,去其根也。", "gengai": ["起:与杨交。", "承:杨妻悍。", "转:以术摄之。", "合:妻乃柔。"], "people": [["马介甫", "术士", "以术摄悍"], ["杨万石", "主人", "妻悍而柔"]], "pingxi": "「马介甫」写术摄悍妇,是《聊斋》的家庭喜剧。", "mingju": "术之摄悍,摄其悍也。", "motifs": {"main": "sorcerer", "accent": ""}}, "213": {"title": "魁星", "notes": [["魁星", "奎星之俗写,主文运之神。"], ["士", "此指应考士人。"], ["异史氏曰", "论赞。"]], "yiyi": "一士人夜见魁星,魁星以笔点之,是科中举。异史氏曰:魁星之笔,点其文,亦点其人。", "gengai": ["起:夜见魁星。", "承:以笔点之。", "转:中举。", "合:点其文亦点其人。"], "people": [["士人", "应考者", "得魁星点"], ["魁星", "文运神", "点之"]], "pingxi": "「魁星」写文运之点,是《聊斋》科举篇的一则。", "mingju": "魁星之笔,点其文,亦点其人。", "motifs": {"main": "scroll", "accent": "star"}}, "214": {"title": "厍将军", "notes": [["厍", "shè,姓。"], ["将军", "武职。"], ["厉", "此写其暴。"], ["异史氏曰", "论赞。"]], "yiyi": "厍将军暴而贪,后为仇家所刺。异史氏曰:将军之暴,暴于生,报于死。", "gengai": ["起:暴而贪。", "承:为仇所刺。", "转:死。", "合:报于死。"], "people": [["厍将军", "暴将", "死而受报"]], "pingxi": "「厍将军」写暴将之报,是《聊斋》的因果篇。", "mingju": "暴于生,报于死。", "motifs": {"main": "sword", "accent": ""}}}