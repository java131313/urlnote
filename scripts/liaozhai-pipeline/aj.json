{
  "235": {
    "title": "萧七",
    "notes": [["萧七", "本篇女主人公,行七。"], ["徐继长", "本篇男主人公。"], ["觇", "chān,窥视。"], ["媪", "老妇。"], ["异史氏曰", "论赞。"]],
    "yiyi": "徐继长遇萧七,娶之。萧七实狐,助徐家。后别去。异史氏曰:狐之七,犹人之七,情之深浅,不在行次。",
    "gengai": ["起:遇萧七。", "承:娶之。", "转:别去。", "合:情不在行次。"],
    "people": [["萧七", "狐女", "助徐而去"], ["徐继长", "主人", "得妻而失"]],
    "pingxi": "「萧七」写狐女之情,行次第七,而情不在行次。",
    "mingju": "情之深浅,不在行次。",
    "motifs": {"main": "fox", "accent": ""}
  },
  "236": {
    "title": "乱离二则",
    "notes": [["乱离", "此写兵燹之惨。"], ["于七", "清初山东起义领袖。"], ["乙酉", "此指顺治二年,1645年。"], ["异史氏曰", "论赞。"]],
    "yiyi": "二则乱离之事:一妇人为兵所掠,不屈而死;一村人避乱山中,为兵所围,死伤甚众。异史氏曰:乱离之惨,一至于此。",
    "gengai": ["起:二则乱离。", "承:兵掠妇死。", "转:村围死伤。", "合:一至于此。"],
    "people": [["妇人", "被掠者", "不屈而死"], ["村人", "被围者", "死伤甚众"]],
    "pingxi": "「乱离二则」写兵燹之惨,是《聊斋》中最沉痛的写实。",
    "mingju": "乱离之惨,一至于此。",
    "motifs": {"main": "bones", "accent": ""}
  },
  "237": {
    "title": "豢蛇",
    "notes": [["豢蛇", "养蛇。"], ["秦中", "陕西一带。"], ["异史氏曰", "论赞。"]],
    "yiyi": "一人养蛇,蛇渐大,为其所制。异史氏曰:蛇之可豢,养之得其时也;人之可养,亦如是也。",
    "gengai": ["起:养蛇。", "承:蛇渐大。", "转:为其所制。", "合:养得其时。"],
    "people": [["其人", "养蛇者", "为蛇所制"], ["蛇", "被养者", "大而制人"]],
    "pingxi": "「豢蛇」写养蛇之反噬,与「蛇人」放蛇得报正反相形。",
    "mingju": "养之得其时也。",
    "motifs": {"main": "snake", "accent": ""}
  },
  "238": {
    "title": "雷公",
    "notes": [["雷公", "雷神。"], ["武清", "河北旧县名。"], ["异史氏曰", "论赞。"]],
    "yiyi": "一雷公下降,击不孝子。异史氏曰:雷公之击,击其不孝;而不孝之众,雷公击不胜击。",
    "gengai": ["起:雷公下降。", "承:击不孝子。", "转:如此。", "合:击不胜击。"],
