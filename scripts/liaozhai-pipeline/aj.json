  "239": {
    "title": "菱角",
    "notes": [["菱角", "本篇女主人公。"], ["胡大成", "本篇男主人公。"], ["媪", "老妇。"], ["异史氏曰", "论赞。"]],
    "yiyi": "胡大成娶菱角,菱角实仙,助其家。异史氏曰:菱角之仙,仙而在下,助夫成业。",
