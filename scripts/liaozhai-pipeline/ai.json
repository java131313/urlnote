{"228": {"title": "胡大姑", "notes": [["胡大姑", "狐女之长者,排行大。"], ["岳于九", "本篇主人。"], ["媪", "老妇。"], ["异史氏曰", "论赞。"]], "yiyi": "岳于九家,胡大姑来居,不祟人,但与小儿戏。后去。异史氏曰:狐之居,与人无争;人之居,与狐何争。", "gengai": ["起:胡大姑来居。", "承:不祟人。", "转:与小儿戏。", "合:去而无争。"], "people": [["胡大姑", "狐", "无争而去"], ["岳于九", "主人", "容之"]], "pingxi": "「胡大姑」写狐之无害,与人无争。", "mingju": "与狐何争。", "motifs": {"main": "fox", "accent": "child"}}, "229": {"title": "细侯", "notes": [["细侯", "本篇女主人公。"], ["满生", "本篇男主人公。"], ["贾", "gǔ,商人。"], ["异史氏曰", "论赞。"]], "yiyi": "满生与细侯相恋,细侯为妓。一贾者欲娶细侯,细侯不从,自赎归满生。异史氏曰:细侯之自赎,自守也;自守者,终得其所。", "gengai": ["起:满生与细侯相恋。", "承:贾者欲娶。", "转:细侯自赎。", "合:归满生。"], "people": [["细侯", "妓女", "自赎自守"], ["满生", "恋人", "得其所"], ["贾者", "夺者", "不得"]], "pingxi": "「细侯」写风尘自守,与「鸦头」一脉,是《聊斋》对底层女子的敬意。", "mingju": "自守者,终得其所。", "motifs": {"main": "maiden", "accent": ""}}, "230": {"title": "狼三则", "notes": [["狼三则", "三则狼的故事,皆写狼之狡与黠。"], ["屠", "屠夫。"], ["苫蔽", "shān bì,覆盖。"], ["黠", "xiá,狡猾。"], ["异史氏曰", "论赞。"]], "yiyi": "三则狼故事:一屠晚归,为狼所逐,投骨缓之,狼仍从;屠乃倚薪持刀,狼不敢前。一屠途遇二狼,诱其一去,杀其一。一则狼入屠室,为屠所杀。异史氏曰:狼之黠,黠于贪;人之智,智于惧。", "gengai": ["起:三则狼事。", "承:狼之狡黠。", "转:屠之应对。", "合:智胜于黠。"], "people": [["屠", "屠夫", "智而杀狼"], ["狼", "狡黠者", "贪而死"]], "pingxi": "「狼三则」是《聊斋》中最著名的狼故事,「狼亦黠矣,而顷刻两毙」之讽,流传最广。", "mingju": "狼亦黠矣,而顷刻两毙。", "motifs": {"main": "wolf", "accent": ""}}, "231": {"title": "美人首", "notes": [["美人首", "美人之首,此写异象。"], ["西安", "陕西西安。"], ["异史氏曰", "论赞。"]], "yiyi": "一人夜见美人首悬于梁,惧而病。异史氏曰:首之悬,心之悬也。", "gengai": ["起:夜见美人首。", "承:惧而病。", "转:心之悬。", "合:如此。"], "people": [["其人", "见者", "惧而病"], ["美人首", "异象", "悬梁"]], "pingxi": "「美人首」写恐惧之来,皆由心生。", "mingju": "首之悬,心之悬也。", "motifs": {"main": "ghost", "accent": ""}}, "232": {"title": "刘亮采", "notes": [["刘亮采", "本篇主人。"], ["狐", "此写其与狐之交。"], ["异史氏曰", "论赞。"]], "yiyi": "刘亮采与狐交,狐助其家。异史氏曰:狐之助,助其德,不助其贪。", "gengai": ["起:与狐交。", "承:狐助其家。", "转:助其德。", "合:不助其贪。"], "people": [["刘亮采", "主人", "得狐之助"], ["狐", "助者", "助德不助贪"]], "pingxi": "「刘亮采」写狐助有德,是《聊斋》人狐之交的常则。", "mingju": "助其德,不助其贪。", "motifs": {"main": "fox", "accent": ""}}, "233": {"title": "蕙芳", "notes": [["蕙芳", "本篇女主人公,仙女。"], ["马二混", "本篇男主人公。"], ["媪", "老妇。"], ["异史氏曰", "论赞。"]], "yiyi": "马二混贫,娶仙女蕙芳,家以小康。后蕙芳别去。异史氏曰:仙女之嫁,嫁其诚也。", "gengai": ["起:娶蕙芳。", "承:家小康。", "转:别去。", "合:嫁其诚。"], "people": [["蕙芳", "仙女", "嫁诚而去"], ["马二混", "主人", "诚而得妻"]], "pingxi": "「蕙芳」写仙嫁其诚,与「阿宝」之诚一脉。", "mingju": "仙女之嫁,嫁其诚也。", "motifs": {"main": "maiden", "accent": ""}}, "234": {"title": "山神", "notes": [["山神", "山之主神。"], ["青州", "山东旧府名。"], ["异史氏曰", "论赞。"]], "yiyi": "一人入山,见山神之祠,神显形,有所诫。异史氏曰:山之神,诫人勿伐山。", "gengai": ["起:入山见祠。", "承:神显形。", "转:有所诫。", "合:勿伐山。"], "people": [["其人", "入山者", "受诫"], ["山神", "诫者", "显形"]], "pingxi": "「山神」写山之灵,是《聊斋》中的自然保护小记。", "mingju": "诫人勿伐山。", "motifs": {"main": "mountain", "accent": "temple"}}}