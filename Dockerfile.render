# Render 单 Pod 全栈镜像:Rust/Leptos 前端(Trunk→dist)+ urlnote-server,
# 运行时由 server 直接托管静态文件(STATIC_DIR + 内置 SPA 回退),
# 前端同源调用 /api、/i,无需 CORS、无需 nginx。
#
# 数据层:FerretDB(MongoDB 线协议) backed by PostgreSQL —— 见 render.yaml。

# ---- 前端运行时资源(npm 包;rust 基础镜像不带 node,用独立 node 阶段拉包) ----
FROM node:20-bookworm AS fe-assets
WORKDIR /app
COPY rust/frontend/package.json rust/frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

# ---- 前端构建(Trunk → dist;trixie 的 glibc 2.41 满足 trunk 0.22 二进制要求) ----
FROM rust:1-trixie AS fe-build
WORKDIR /app
# workspace 布局:frontend 是 workspace 成员且 path 依赖 shared;
# 精简 members(桌面/worker 不进镜像),保留 release profile(wasm 体积)
COPY rust/Cargo.toml rust/Cargo.lock ./
RUN printf '[workspace]\nmembers = ["shared", "frontend"]\nresolver = "2"\n\n[profile.release]\nopt-level = "s"\nlto = true\n' > Cargo.toml
COPY rust/shared ./shared
COPY rust/frontend/package.json rust/frontend/package-lock.json ./frontend/
COPY --from=fe-assets /app/node_modules ./frontend/node_modules
COPY rust/frontend/ ./frontend/
WORKDIR /app/frontend
# Trunk(按构建架构取二进制;Render 构建机为 x86_64)
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) TRUNK=x86_64-unknown-linux-gnu ;; \
      arm64) TRUNK=aarch64-unknown-linux-gnu ;; \
      *) TRUNK=x86_64-unknown-linux-gnu ;; \
    esac; \
    curl -sSfL "https://github.com/trunk-rs/trunk/releases/download/v0.22.0/trunk-${TRUNK}.tar.gz" | tar -xz -C /usr/local/bin
RUN rustup target add wasm32-unknown-unknown
# /oss 文件库编译期凭据(Render 把服务环境变量作为 build-arg 注入;
# 与 pages.yml 同一套,本就编译进公开 WASM)
ARG OSS_ENDPOINT
ARG OSS_BUCKET
ARG OSS_REGION
ARG OSS_AK
ARG OSS_SK
ENV OSS_ENDPOINT=$OSS_ENDPOINT OSS_BUCKET=$OSS_BUCKET OSS_REGION=$OSS_REGION OSS_AK=$OSS_AK OSS_SK=$OSS_SK
# Vditor/mammoth/turndown/pdfjs 运行时资源 staging(与 pages.yml 一致)
RUN rm -rf static/vditor static/mammoth static/turndown static/pdfjs \
    && mkdir -p static/vditor static/mammoth static/turndown static/pdfjs \
    && cp -R node_modules/vditor/dist static/vditor/dist \
    && cp node_modules/mammoth/mammoth.browser.min.js static/mammoth/ \
    && cp node_modules/turndown/dist/turndown.js static/turndown/ \
    && cp node_modules/pdfjs-dist/legacy/build/pdf.min.js \
          node_modules/pdfjs-dist/legacy/build/pdf.worker.min.js \
          static/pdfjs/
# API_BASE 不设置 = 同源;--public-url / = 根路径部署(onrender 域名或自定义域名)
RUN trunk build --release --public-url / \
    && rm -rf dist/vditor dist/mammoth dist/turndown dist/pdfjs \
    && cp -R static/vditor static/mammoth static/turndown static/pdfjs dist/ \
    && mkdir -p dist/dict && cp -R static/dict/. dist/dict/

# ---- 后端构建(精简 workspace:shared + server) ----
FROM rust:1-bookworm AS be-build
WORKDIR /app/rust
COPY rust/Cargo.toml rust/Cargo.lock ./
RUN printf '[workspace]\nmembers = ["shared", "server"]\nresolver = "2"\n' > Cargo.toml
COPY rust/shared ./shared
COPY rust/server ./server
RUN cargo build --release -p urlnote-server

# ---- 运行时(免费档单 Pod:FerretDB 同容器 + urlnote-server + 静态前端) ----
FROM debian:bookworm-slim
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
# FerretDB 1.24.2 独立二进制(纯 Go 静态编译,跨发行版)
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) FDB_ARCH=amd64 ;; \
      arm64) FDB_ARCH=arm64 ;; \
      *) FDB_ARCH=amd64 ;; \
    esac; \
    curl -sSfL "https://github.com/FerretDB/FerretDB/releases/download/v1.24.2/ferretdb-linux-${FDB_ARCH}" -o /usr/local/bin/ferretdb \
    && chmod +x /usr/local/bin/ferretdb
WORKDIR /app
COPY --from=be-build /app/rust/target/release/urlnote-server /app/urlnote-server
COPY --from=fe-build /app/frontend/dist /app/static
COPY rust/frontend/static/dict/system_ipadic.dic.zst /app/dict/system_ipadic.dic.zst
COPY docker/render-start.sh /app/start.sh
ENV IPADIC_PATH=/app/dict/system_ipadic.dic.zst \
    STATIC_DIR=/app/static \
    PORT=8080
EXPOSE 8080
CMD ["/app/start.sh"]
