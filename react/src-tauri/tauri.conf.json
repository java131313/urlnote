{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "urlnote",
  "version": "0.1.0",
  "identifier": "io.github.java131313.urlnote",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "VITE_BASE_PATH=./ VITE_API_BASE=https://yyuqmndqpnjr.sealosbja.site npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "urlnote",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
