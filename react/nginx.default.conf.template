server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # 后端 API 与图片:运行时用 API_TARGET 替换(nginx 官方镜像的
    # /etc/nginx/templates 机制会在启动前做 envsubst)
    # Sealos 网关(Envoy)按 SNI 路由:必须显式开启 SNI,否则握手被拒 → 502
    proxy_ssl_server_name on;

    location /api/ {
        # 不改写 Host:nginx 默认带上游域名,Sealos 网关按 Host 路由,
        # 传 $host(localhost:3000)会 404
        proxy_pass ${API_TARGET};
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
        client_max_body_size 9m;
    }
    location /i/ {
        proxy_pass ${API_TARGET};
        proxy_set_header X-Forwarded-Proto https;
    }

    # 内容哈希资源长缓存;index.html 不缓存,保证拿到新哈希
    location ~* \.(?:js|css|wasm)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA 回退
    location / {
        try_files $uri $uri/ /index.html;
    }
}
